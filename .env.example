# MEG uses StudioNet for product interactions. Leave addresses blank for a non-signing preview.
NEXT_PUBLIC_GENLAYER_GAME_NETWORK=studionet
NEXT_PUBLIC_GENLAYER_GAME_RPC_URL=
NEXT_PUBLIC_GENLAYER_GAME_ADDRESS=
NEXT_PUBLIC_GENLAYER_ROUND_RESOLVER_ADDRESS=
NEXT_PUBLIC_GENLAYER_GAME_ROUND_ID=synthetic-meg-valorant-series-001
NEXT_PUBLIC_GENLAYER_RESOLUTION_ID=meg-synthetic-series-001

# Optional wallet labels. These are disclosed in the UI and are never funded automatically.
NEXT_PUBLIC_GENLAYER_BOT_ADDRESSES=
NEXT_PUBLIC_GENLAYER_FORM_BOT_ADDRESS=
NEXT_PUBLIC_GENLAYER_CHAOS_BOT_ADDRESS=

# Used only by deterministic local replay affordances.
NEXT_PUBLIC_REPLAY_SECONDS=8
